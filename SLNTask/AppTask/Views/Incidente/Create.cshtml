@model AppTask.Models.Incidente

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Incidente</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form action="/Incidente/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group mb-3">
                <label for="DescricaoProblema" class="control-label">Descrição do Problema</label>
                <input type="text" id="DescricaoProblema" name="DescricaoProblema" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="DataIncidente" class="control-label">Data do Incidente</label>
                <input type="datetime-local" id="DataIncidente" name="DataIncidente" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="Solucao" class="control-label">Solução</label>
                <input type="text" id="Solucao" name="Solucao" class="form-control" />
            </div>

            <div class="form-group form-check mb-3">
                <input type="checkbox" id="Resolvido" name="Resolvido" value="true" class="form-check-input" />
                <label for="Resolvido" class="form-check-label">Resolvido</label>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a href="/Incidente/Index">Back to List</a>
</div>