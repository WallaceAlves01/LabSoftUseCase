@model AppTask.Models.CentralDeCusto

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>CentralDeCusto</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form action="/CentralDeCusto/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group mb-3">
                <label for="NomeCentral" class="control-label">Nome Central</label>
                <input type="text" id="NomeCentral" name="NomeCentral" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="ValorMetaAnual" class="control-label">Valor Meta Anual</label>
                <input type="number" step="0.01" id="ValorMetaAnual" name="ValorMetaAnual" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a href="/CentralDeCusto/Index">Back to List</a>
</div>