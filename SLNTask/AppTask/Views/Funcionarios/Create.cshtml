@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Funcionario</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form action="/Funcionario/Create" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group mb-3">
                <label for="Nome" class="control-label">Nome</label>
                <input type="text" id="Nome" name="Nome" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="Cargo" class="control-label">Cargo</label>
                <input type="text" id="Cargo" name="Cargo" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label for="DepartamentoId" class="control-label">Departamento</label>
                <select id="DepartamentoId" name="DepartamentoId" class="form-control">
                    <option value="">-- Selecione um Departamento --</option>
                    @if (ViewBag.ListaDepartamento != null)
                    {
                        foreach (var dep in ViewBag.ListaDepartamento)
                        {
                            <option value="@dep.Value">@dep.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a href="/Funcionario/Index">Back to List</a>
</div>